{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["jest", "node", "@testing-library/jest-native"]
  },
  "include": [
    "src",
    "index.js",
    "App.tsx",
    "__tests__",
    "src/__tests__",
    "nativewind-env.d.ts",
    "env.d.ts"
  ]
}
